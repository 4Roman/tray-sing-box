# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build directory
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# Windows resource files
*.syso

# sing-box files (don't commit these)
sing-box.exe
sing-box.exe.old
config.json
config.json.bak
cache.db
subscriptions.json

# Build artifacts
*.log

# Generated icons (rendered from assets/icons/tray.svg by tools/genicons)
/assets/icons/*.ico

# Claude Code local state
/.claude/
config-history/

# Release signing key (tools/relkey output) - never commit
release-signing-key*.txt
