# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build directory
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# Windows resource files
*.syso

# sing-box files (don't commit these)
sing-box.exe
sing-box.exe.old
config.json
config.json.bak
cache.db
subscriptions.json

# Build artifacts
*.log

# Generated icons (rendered from assets/icons/tray.svg by tools/genicons)
/assets/icons/*.ico

# Claude Code local state
/.claude/
config-history/

# Release signing key (tools/relkey output) - never commit; relkey refuses a
# path inside a repository, these only catch a copy dropped in by hand
release-signing-key*
*signing-key*
*.pem
*.key

# Release assets (tools/relsign writes checksums next to the downloaded exe)
/dist/
*.zip

# Runtime leftovers next to a portable copy
*.old
*.new
dpi-params.txt
go.work.sum

# The maintainer's working notes (Claude Code instructions, audit report,
# test checklist): machine-specific, kept local, not published
/CLAUDE.md
/CLAUDE.local.md
/21.09.2026.md
/21.09.2026-checklist.md
